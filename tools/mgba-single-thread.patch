+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef WASM_SINGLE_THREAD_H
+#define WASM_SINGLE_THREAD_H
+
+#include <mgba-util/common.h>
+
+CXX_GUARD_START
+
+struct mCoreThread;
+
+// Advances the core by however many frames the fixed timestep owes us, and
+// returns true if at least one ran (i.e. there is a new frame worth blitting).
+bool mCoreSingleThreadStep(struct mCoreThread* threadContext, bool timestepSync);
+
+CXX_GUARD_END
+
+#endif
