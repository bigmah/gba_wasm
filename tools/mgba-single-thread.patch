diff --git a/src/platform/wasm/single-thread.c b/src/platform/wasm/single-thread.c
new file mode 100644
index 0000000..da93839
--- /dev/null
+++ b/src/platform/wasm/single-thread.c
@@ -0,0 +1,235 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Single-threaded stand-ins for the mCoreThread API.
+ *
+ * The threaded wasm build runs the core on its own pthread, so every call that
+ * reaches into the core from the main thread has to fence it with
+ * mCoreThreadInterrupt/mCoreThreadContinue. Here the core runs inline on the
+ * browser's main loop (see runLoop in main.c), so it is never mid-frame when
+ * one of these is called and the fencing collapses to nothing.
+ *
+ * Keeping the mCoreThread surface rather than deleting it from main.c means the
+ * `renderer->thread` sentinel and all its null checks keep working unchanged,
+ * and the diff against upstream stays confined to the run loop.
+ */
+
+#include "single-thread.h"
+
+#include <mgba/core/core.h>
+#include <mgba/core/rewind.h>
+#include <mgba/core/thread.h>
+
+#include <emscripten.h>
+
+// mCoreRewindContext has no "is initialized" flag of its own and double-init
+// would leak its patch vector, so track it here. There is exactly one core in
+// this build, so a single static is enough.
+static bool _rewindActive = false;
+
+// Fixed-timestep accumulator, mirroring the one the threaded build runs on its
+// CPU thread. No sleeping here: requestAnimationFrame already paces us.
+static double _previousTime = 0.0;
+static double _accumulator = 0.0;
+
+// Per-frame rewind bookkeeping, registered as a core callback exactly as the
+// threaded build does, so it stays in step with the core's own frame boundaries.
+static void _frameStarted(void* context) {
+	struct mCoreThread* thread = context;
+	if (!thread || !thread->impl) {
+		return;
+	}
+	if (!thread->core->opts.rewindEnable || thread->core->opts.rewindBufferCapacity <= 0) {
+		return;
+	}
+	if (thread->impl->rewinding) {
+		mCoreRewindRestore(&thread->impl->rewind, thread->core, 1);
+		return;
+	}
+	if (thread->impl->rewind.rewindFrameCounter == 0) {
+		mCoreRewindAppend(&thread->impl->rewind, thread->core);
+		thread->impl->rewind.rewindFrameCounter = thread->core->opts.rewindBufferInterval;
+	}
+	thread->impl->rewind.rewindFrameCounter--;
+}
+
+static void _frameEnded(void* context) {
+	struct mCoreThread* thread = context;
+	if (thread && thread->frameCallback) {
+		thread->frameCallback(thread);
+	}
+}
+
+void mCoreThreadAddCoreCallbacks(struct mCoreThread* threadContext) {
+	struct mCoreCallbacks callbacks = {
+		.videoFrameStarted = _frameStarted,
+		.videoFrameEnded = _frameEnded,
+		.context = threadContext,
+	};
+	threadContext->core->addCoreCallbacks(threadContext->core, &callbacks);
+}
+
+void mCoreThreadRewindParamsChanged(struct mCoreThread* threadContext) {
+	if (!threadContext || !threadContext->impl) {
+		return;
+	}
+	struct mCore* core = threadContext->core;
+	bool wanted = core->opts.rewindEnable && core->opts.rewindBufferCapacity > 0;
+	if (wanted == _rewindActive) {
+		return;
+	}
+	if (wanted) {
+		mCoreRewindContextInit(&threadContext->impl->rewind, core->opts.rewindBufferCapacity, false);
+	} else {
+		mCoreRewindContextDeinit(&threadContext->impl->rewind);
+	}
+	_rewindActive = wanted;
+}
+
+bool mCoreThreadStart(struct mCoreThread* threadContext) {
+	struct mCore* core = threadContext->core;
+
+	threadContext->impl = calloc(1, sizeof(*threadContext->impl));
+	if (!threadContext->impl) {
+		return false;
+	}
+	threadContext->impl->core = core;
+	threadContext->impl->state = mTHREAD_RUNNING;
+	threadContext->impl->rewinding = false;
+
+	// The core still gets a sync block because it posts frames and audio
+	// through it, but both waits stay off: with nothing to hand off to, a
+	// wait would just stall the browser's main loop.
+	threadContext->impl->sync.videoFrameWait = false;
+	threadContext->impl->sync.audioWait = false;
+	threadContext->impl->sync.fpsTarget = core->opts.fpsTarget;
+	threadContext->impl->sync.audioHighWater = 512;
+	core->setSync(core, &threadContext->impl->sync);
+
+	mCoreThreadAddCoreCallbacks(threadContext);
+	mCoreThreadRewindParamsChanged(threadContext);
+
+	if (threadContext->startCallback) {
+		threadContext->startCallback(threadContext);
+	}
+
+	core->reset(core);
+
+	if (threadContext->resetCallback) {
+		threadContext->resetCallback(threadContext);
+	}
+
+	_previousTime = emscripten_get_now();
+	_accumulator = 0.0;
+	return true;
+}
+
+bool mCoreSingleThreadStep(struct mCoreThread* threadContext, bool timestepSync) {
+	if (!mCoreThreadIsActive(threadContext)) {
+		return false;
+	}
+	struct mCore* core = threadContext->core;
+
+	if (!timestepSync) {
+		core->runFrame(core);
+		return true;
+	}
+
+	float fpsTarget = threadContext->impl->sync.fpsTarget;
+	if (fpsTarget <= 0) {
+		fpsTarget = 60.0f;
+	}
+	const double stepMs = 1000.0 / fpsTarget;
+	const double maxCatchup = 250.0; // clamp so a backgrounded tab cannot bank hours of frames
+
+	// Fast-forward raises fpsTarget, so the per-tick frame budget has to rise
+	// with it or the accumulator grows without bound and never catches up.
+	int maxSteps = (int) (fpsTarget / 30.0) + 2;
+
+	double now = emscripten_get_now();
+	double dt = now - _previousTime;
+	if (dt > maxCatchup) {
+		dt = maxCatchup;
+	}
+	_previousTime = now;
+	_accumulator += dt;
+
+	int steps = 0;
+	while (_accumulator >= stepMs && steps < maxSteps) {
+		core->runFrame(core);
+		_accumulator -= stepMs;
+		++steps;
+	}
+	if (steps == maxSteps) {
+		// Ran out of budget; drop the backlog rather than accumulate debt.
+		_accumulator = 0.0;
+	}
+	return steps > 0;
+}
+
+bool mCoreThreadIsActive(struct mCoreThread* threadContext) {
+	if (!threadContext || !threadContext->impl) {
+		return false;
+	}
+	return threadContext->impl->state == mTHREAD_RUNNING;
+}
+
+void mCoreThreadPause(struct mCoreThread* threadContext) {
+	if (threadContext && threadContext->impl) {
+		threadContext->impl->state = mTHREAD_PAUSED;
+		if (threadContext->pauseCallback) {
+			threadContext->pauseCallback(threadContext);
+		}
+	}
+}
+
+void mCoreThreadUnpause(struct mCoreThread* threadContext) {
+	if (threadContext && threadContext->impl) {
+		threadContext->impl->state = mTHREAD_RUNNING;
+		// Re-baseline the clock: time spent paused is not frame debt.
+		_previousTime = emscripten_get_now();
+		_accumulator = 0.0;
+		if (threadContext->unpauseCallback) {
+			threadContext->unpauseCallback(threadContext);
+		}
+	}
+}
+
+void mCoreThreadEnd(struct mCoreThread* threadContext) {
+	if (threadContext && threadContext->impl) {
+		threadContext->impl->state = mTHREAD_EXITING;
+	}
+}
+
+void mCoreThreadJoin(struct mCoreThread* threadContext) {
+	if (!threadContext || !threadContext->impl) {
+		return;
+	}
+	if (_rewindActive) {
+		mCoreRewindContextDeinit(&threadContext->impl->rewind);
+		_rewindActive = false;
+	}
+	if (threadContext->cleanCallback) {
+		threadContext->cleanCallback(threadContext);
+	}
+	threadContext->core->clearCoreCallbacks(threadContext->core);
+	free(threadContext->impl);
+	threadContext->impl = NULL;
+}
+
+void mCoreThreadSetRewinding(struct mCoreThread* threadContext, bool rewinding) {
+	if (threadContext && threadContext->impl) {
+		threadContext->impl->rewinding = rewinding;
+	}
+}
+
+// The core is only ever touched between frames here, so there is nothing to
+// interrupt and nothing to resume.
+void mCoreThreadInterrupt(struct mCoreThread* threadContext) {
+	UNUSED(threadContext);
+}
+
+void mCoreThreadContinue(struct mCoreThread* threadContext) {
+	UNUSED(threadContext);
+}
